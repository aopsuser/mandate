# ---------------------------------------------------------------------------
# Everything here is optional. With an empty file the app runs in
# mock-payment / heuristic-planner mode and every flow still works.
# ---------------------------------------------------------------------------

# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Only needed if you want /api/webhooks/paypal to verify signatures.
PAYPAL_WEBHOOK_ID=
# Advanced: point the client at a stub or proxy instead of PayPal.
# PAYPAL_API_BASE=http://127.0.0.1:9999

# Any OpenAI-compatible chat endpoint (OpenAI, Groq, Together, Ollama, ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional overrides
# MANDATE_SECRET=change-me
# HOST=127.0.0.1
# PORT=3000
